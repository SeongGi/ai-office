# 복사해서 .env로 쓴다: cp .env.example .env  (.env는 커밋하지 않는다)

# 기계(훅, seed, close-agent)가 쓰는 토큰. 새로 만든다: openssl rand -hex 24
AI_OFFICE_TOKEN=change-me
# 제어 권한(닫기, 지시 보내기)을 줄 구글 계정. 쉼표로 여러 명.
AI_OFFICE_ADMINS=you@example.com
# 한 방에 앉는 메인 세션 수
AI_OFFICE_ROOM_MAX=5
# 권한 확인 없이 도는 세션(bypassPermissions)에도 지시를 보내려면 1. 기본은 막는다.
# AI_OFFICE_ALLOW_BYPASS_SEND=0

# 구글 로그인 프록시(oauth2-proxy). 구글 콘솔 OAuth 클라이언트에서 복사한다.
OAUTH2_PROXY_CLIENT_ID=your-client-id.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=your-client-secret
# 쿠키 비밀: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=change-me
