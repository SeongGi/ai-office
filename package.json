{
  "name": "ai-office",
  "version": "0.1.0",
  "description": "A live 2D office for your coding agents, staffed by cats. See every agent at its desk, what it is doing, and who it is talking to. Works with Claude Code, Codex, Cursor, or anything that can send an HTTP request.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ai-office": "bin/ai-office.mjs"
  },
  "files": [
    "adapters",
    "bin",
    "desktop",
    "dist",
    "server",
    "shared"
  ],
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "cursor",
    "visualization",
    "2d",
    "cats",
    "multi-agent",
    "observability"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "build:pages": "tsc --noEmit && vite build --base=./ --mode pages --outDir dist-pages",
    "start": "node bin/ai-office.mjs start --open",
    "install-app": "node bin/ai-office.mjs install-app",
    "demo": "node bin/ai-office.mjs demo",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import ./test/support/clean-env.mjs test/*.test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeongGi/ai-office.git"
  },
  "homepage": "https://github.com/SeongGi/ai-office#readme",
  "bugs": {
    "url": "https://github.com/SeongGi/ai-office/issues"
  },
  "optionalDependencies": {
    "electron": "^44.7.0"
  }
}
